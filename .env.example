# wafpass-dashboard — local development environment
# Copy to .env.local — Vite reads .env.local automatically and never commits it.
# Only variables prefixed with VITE_ are bundled into the browser build.

# ── API connection ─────────────────────────────────────────────────────────────
# Base URL of wafpass-server (no trailing slash, no /runs suffix).
# Default when unset: same origin as the dashboard.
#   - Docker Compose: leave unset — nginx proxies /api to wafpass-server:8000
#   - Local dev (npm run dev): set to http://localhost:8000 so Vite's proxy forwards correctly
#   - Cross-origin production: set to the public server URL
VITE_API_URL=http://localhost:8000
